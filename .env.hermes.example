OPENROUTER_API_KEY=
AI_PROVIDER=openrouter

# Tala agent (guest-facing) — use a fast model for low latency
HERMES_TALA_MODEL=meta-llama/llama-3.1-8b-instruct

# Workforce agent (admin tasks) — use a different model to spread rate limits
HERMES_WORKFORCE_MODEL=mistralai/mistral-7b-instruct

OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
HERMES_DOMAIN=hermes.yourresort.com

HERMES_TALA_API_KEY=replace-with-a-long-random-secret
HERMES_TALA_API_URL=http://127.0.0.1:8642

HERMES_WORKFORCE_API_KEY=replace-with-a-different-long-random-secret
HERMES_WORKFORCE_API_URL=http://127.0.0.1:8643
HERMES_WORKFORCE_ACCESS_KEY=owner-enters-this-key-in-admin

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESORT_CMS_KEY=marina_terrace_payload

TALA_GITHUB_REPOSITORY=merqatodigital/set-sail-project
GITHUB_TOKEN=
RESEND_API_KEY=
