{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "talla-agent-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talla-staging-db",
      "database_id": "9e47f804-c263-4898-8d2c-c0f11fb2baf0"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TALLA_AGENT",
        "class_name": "TallaAgent"
      }
    ]
  },
  "workflows": [
    {
      "name": "daily-briefing",
      "binding": "DAILY_BRIEFING",
      "class_name": "DailyResortBriefingWorkflow",
      "schedules": ["0 0 * * *"]
    },
    {
      "name": "talla-approval",
      "binding": "TALLA_APPROVAL",
      "class_name": "TallaApprovalWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TallaAgent"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "tala@merqato.digital",
      "forwarding_email": "forward@merqato.digital"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "email_routes": [
    "*@tala.merqato.digital"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "TALLA_COMPUTER_ENABLED": "true",
    "ENVIRONMENT": "staging",
    "AI_SEARCH_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "AI_SEARCH_INDEX": "marina-terrace-knowledge"
  }
}
