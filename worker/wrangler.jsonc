{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "talla-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talla-resort-db",
      "database_id": "4cf66029-e11c-4ba9-a974-135adce8abfa"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TALLA_AGENT",
        "class_name": "TallaAgent"
      }
    ]
  },
  "workflows": [
    {
      "name": "daily-briefing",
      "binding": "DAILY_BRIEFING",
      "class_name": "DailyResortBriefingWorkflow",
      "schedules": ["0 0 * * *"]
    },
    {
      "name": "talla-approval",
      "binding": "TALLA_APPROVAL",
      "class_name": "TallaApprovalWorkflow"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TallaAgent"]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "tala@merqato.digital",
      "forwarding_email": "forward@merqato.digital"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TALLA_COMPUTER_ENABLED": "true",
    "ENVIRONMENT": "production"
  }
}
